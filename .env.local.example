# Insforge project URL (public)
NEXT_PUBLIC_INSFORGE_URL=https://your-project.eu-central.insforge.app

# Insforge anonymous key (public — safe to expose in the browser)
NEXT_PUBLIC_INSFORGE_ANON_KEY=your-anon-key-here

# Insforge service key (PRIVATE — server-only, never in NEXT_PUBLIC_*)
INSFORGE_SERVICE_KEY=your-service-key-here

# Admin notification email (used by notify-admin-new-listing edge function)
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# VAPID keys for Web Push notifications
# Generate once with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is safe to expose (browser uses it to subscribe)
# VAPID_PRIVATE_KEY is server-only — never put it in NEXT_PUBLIC_*
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:your-email@example.com
